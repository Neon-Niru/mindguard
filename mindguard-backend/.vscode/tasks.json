{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run backend tests",
			"type": "shell",
			"command": "python -m unittest discover -s tests -t . -v",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "Run API",
			"type": "shell",
			"command": "python -m flask --app app.py run --port=5000",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}
